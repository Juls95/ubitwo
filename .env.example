# ubitwo · copia este archivo como .env (nunca subas .env al repositorio).
# Todo es opcional: sin variables, ubitwo arranca con noticias de demostración y la tesis simulada.
# Revisa qué falta con: pnpm check-env

NODE_ENV=development
PORT=3000

# --- Servidor y acceso -------------------------------------------------------
# URL pública (en Render: https://<tu-servicio>.onrender.com). Necesaria en producción para el enlace mágico.
APP_URL=
# 32+ caracteres aleatorios. Genera uno con: openssl rand -base64 48
SESSION_SECRET=
# Correos que pueden entrar, separados por comas.
EMAILS_PERMITIDOS=
LIMITE_PETICIONES_POR_MINUTO=120

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=
# Pública (sirve para el enlace mágico).
SUPABASE_ANON_KEY=
# SECRETA: solo en el servidor y en el cron de sincronización. Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Separa los datos si compartes un proyecto de Supabase entre varios despliegues.
ESPACIO_ID=principal

# --- Notion ------------------------------------------------------------------
# Token de una integración interna; comparte con ella las bases que debe leer.
NOTION_TOKEN=
NOTION_VERSION=2022-06-28
# Base "Daily Market Digest" donde el bot escribe un resumen por día.
NOTION_DB_RESUMENES=b9c8d51185c9473fb93ba810788cf536
# Opcional: si la base tiene varios dueños, filtra por la propiedad (persona o correo) y el correo.
NOTION_PROP_USUARIO=
NOTION_FILTRO_USUARIO=
# Opcional (tesis): sobrescriben los IDs de config/oso.notion.yaml.
NOTION_DB_TICKERS_INFO=
NOTION_DB_X_CREATIVE=
NOTION_DB_X_ANALYSES=

# --- IA ----------------------------------------------------------------------
# Cambiar de modelo es cambiar estas dos variables.
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
# Solo si LLM_PROVIDER=xai, o para que Oso busque en X (tesis).
XAI_API_KEY=
XAI_MODEL=grok-4.7

# --- Tesis (opcional) --------------------------------------------------------
# live usa data/tesis si existe; si no, el build publica el escenario simulado.
DATA_MODE=live
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
BQ_MAX_BYTES=20000000000
INTENTS_JWT=
