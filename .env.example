# ubitwo · copy this file as .env (never commit .env).
# Everything is optional: with no variables, ubitwo boots with demo news and the simulated thesis.
# Check what is missing with: pnpm check-env

NODE_ENV=development
PORT=3000

# --- Server and access -------------------------------------------------------
# Public URL (on Render: https://<your-service>.onrender.com). Required in production for the magic link.
APP_URL=
# 32+ random characters. Generate one with: openssl rand -base64 48
SESSION_SECRET=
# Emails allowed to sign in, comma-separated.
EMAILS_PERMITIDOS=
LIMITE_PETICIONES_POR_MINUTO=120

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=
# Public (used for the magic link).
SUPABASE_ANON_KEY=
# SECRET: server and sync cron only. Never in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Isolate data if you share one Supabase project across several deployments.
ESPACIO_ID=principal

# --- Notion ------------------------------------------------------------------
# Token for an internal integration; share with it the databases it must read.
NOTION_TOKEN=
NOTION_VERSION=2022-06-28
# "Daily Market Digest" database where the bot writes one digest per day.
NOTION_DB_RESUMENES=b9c8d51185c9473fb93ba810788cf536
# Optional: if the database has several owners, filter by the property (person or email) and the email.
NOTION_PROP_USUARIO=
NOTION_FILTRO_USUARIO=
# Optional (thesis): override the IDs in config/oso.notion.yaml.
NOTION_DB_TICKERS_INFO=
NOTION_DB_X_CREATIVE=
NOTION_DB_X_ANALYSES=

# --- AI ----------------------------------------------------------------------
# Changing models is changing these two variables.
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
# Only if LLM_PROVIDER=xai, or so Bear can search X (thesis).
XAI_API_KEY=
XAI_MODEL=grok-4.7

# --- Thesis (optional) -------------------------------------------------------
# live uses data/tesis if present; otherwise the build publishes the simulated scenario.
DATA_MODE=live
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
BQ_MAX_BYTES=20000000000
INTENTS_JWT=
