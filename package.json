{
  "name": "ubitwo",
  "version": "0.1.0",
  "private": true,
  "description": "ubitwo: dashboard de noticias de mercado (resúmenes diarios desde Notion y Supabase) y tesis de inversión basada en evidencia.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "build": "tsx src/tesis/build-site.ts && vite build",
    "noticias:sync": "tsx src/noticias/sync/run.ts",
    "tesis:mock": "tsx src/tesis/mock/run.ts",
    "tesis:bisonte": "tsx src/tesis/bisonte/run.ts",
    "tesis:oso": "tsx src/tesis/oso/run.ts",
    "tesis:oso:notion": "tsx src/tesis/oso/notion/run.ts",
    "tesis:oso:historico": "tsx src/tesis/oso/run.ts --backfill-weeks 4",
    "tesis:toro": "tsx src/tesis/toro/build.ts",
    "tesis:refresh": "pnpm tesis:bisonte && pnpm tesis:oso:notion && pnpm tesis:oso && pnpm tesis:toro",
    "tesis:verificar": "tsx src/tesis/toro/verify.ts",
    "demo": "pnpm tesis:mock && DATA_MODE=mock pnpm tesis:toro && vite build",
    "check-env": "tsx scripts/check-env.ts",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@google-cloud/bigquery": "9.5.0",
    "debug": "4.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-lite": "6.5.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/debug": "4.1.13",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "babel-jest": "30.5.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  }
}
